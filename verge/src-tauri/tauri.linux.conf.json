{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "identifier": "io.github.cute-rui.pixiu",
  "bundle": {
    "targets": ["deb", "rpm"],
    "linux": {
      "deb": {
        "depends": ["openssl", "libayatana-appindicator3-1"],
        "desktopTemplate": "./packages/linux/pixiu.desktop",
        "postInstallScript": "./packages/linux/post-install.sh",
        "preRemoveScript": "./packages/linux/pre-remove.sh"
      },
      "rpm": {
        "depends": ["openssl", "libayatana-appindicator-gtk3"],
        "recommends": ["policycoreutils", "policycoreutils-python-utils"],
        "desktopTemplate": "./packages/linux/pixiu.desktop",
        "postInstallScript": "./packages/linux/post-install-rpm.sh",
        "preRemoveScript": "./packages/linux/pre-remove.sh"
      }
    },
    "externalBin": [
      "./sidecar/pixiu-service",
      "./sidecar/pixiu-service-install",
      "./sidecar/pixiu-service-uninstall",
      "./sidecar/pixiu-mihomo",
      "./sidecar/pixiu-mihomo-alpha"
    ]
  }
}
