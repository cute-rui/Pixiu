<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/separator" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:text="@string/exit_node_title"
        android:textColor="#B3B3B3"
        android:textSize="13sp"
        android:textAllCaps="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/tab_netbird"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/exit_node_tab_netbird" />

        <Button
            android:id="@+id/tab_mihomo"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/exit_node_tab_mihomo" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/netbird_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/exit_node_picker_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:listitem="@layout/list_item_exit_node_picker" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mihomo_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/mihomo_subscription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/mihomo_subscription_hint"
            android:inputType="textUri"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/mihomo_update"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mihomo_update" />

        <TextView
            android:id="@+id/mihomo_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textColor="#B3B3B3" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mihomo_nodes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:listitem="@layout/list_item_exit_node_picker" />

        <EditText
            android:id="@+id/wifi_blacklist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="top"
            android:hint="@string/wifi_blacklist_hint"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:importantForAutofill="no" />
    </LinearLayout>

</LinearLayout>
